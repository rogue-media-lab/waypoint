# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~

# Local data overrides (keep the shipped seed DB, ignore local copies)
database/vehicle_data.db
*.db-journal
*.db-wal

# Local photo / image cache paths never belong in the repo
*.local-photos

# Python test/venv artifacts
.venv/
.pytest_cache/

# Local backups taken before a data repair or migration — never commit these.
# The convention is <file>.bak-pre-<reason>-<timestamp>.
*.bak-pre-*
*.db.bak*

# Working notes, mockups and plans. These hold product strategy — pricing,
# margins, competitor analysis — and this repository is public. They stay local
# on purpose: add them to the repo only by deliberate decision, not by accident.
docs/
plans/

